# Django secret key — required, must be a long random string in production
SECRET_KEY=your-secret-key-here

# Debug mode — set to True only during local development, never in production
DEBUG=False

# Comma-separated list of allowed hostnames (e.g. example.com,www.example.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection string — required
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# n8n webhook endpoint URL — required
# This is the URL of the n8n webhook node that receives submission data
N8N_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/your-webhook-id

# Shared secret sent as the X-Webhook-Secret header with every webhook call
# Set the same value in n8n to verify requests originate from this application
N8N_WEBHOOK_SECRET=your-webhook-secret-here
